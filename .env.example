# Copiar a .env y completar localmente. Nunca subir .env al repositorio.
# PostgreSQL existente: reemplazar usuario, clave (codificada como URL), host y base.
DATABASE_URL=postgresql+psycopg://p1:CAMBIAR_CLAVE@localhost:55432/homicidios_p1
# Para la alternativa Docker, usar la misma clave que en DATABASE_URL.
POSTGRES_USER=p1
POSTGRES_PASSWORD=CAMBIAR_CLAVE
POSTGRES_DB=homicidios_p1
